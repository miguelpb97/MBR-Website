Options -Indexes
RewriteEngine On

# Si acceden directamente al PHP -> /admin
RewriteCond %{THE_REQUEST} \s/+admin/admin_requests\.php[\s?] [NC]
RewriteRule ^admin/admin_requests\.php$ /admin [R=301,L]

# Redirigir index.php a la home limpia
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ https://www.mbretrofitalmeria.es/ [R=301,L]

# Redirecciones de URLs antiguas a nuevas (301)
RewriteCond %{THE_REQUEST} \s/+servicios\.php[\s?] [NC]
RewriteRule ^servicios\.php$ /servicios [R=301,L]

RewriteCond %{THE_REQUEST} \s/+store\.php[\s?] [NC]
RewriteRule ^store\.php$ /store [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contacto\.php[\s?] [NC]
RewriteRule ^contacto\.php$ /contacto [R=301,L]

RewriteCond %{THE_REQUEST} \s/+terminos-y-condiciones\.php[\s?] [NC]
RewriteRule ^terminos-y-condiciones\.php$ /terminos-y-condiciones [R=301,L]

RewriteCond %{THE_REQUEST} \s/+politica-de-privacidad\.php[\s?] [NC]
RewriteRule ^politica-de-privacidad\.php$ /politica-de-privacidad [R=301,L]

# Servicios individuales con slug de variante + servicio
RewriteRule ^servicio/([a-z0-9-]+)/([a-z0-9-]+)/?$ servicio.php?variante=$1&servicio=$2 [L,QSA]

# URLs LIMPIAS INTERNAS
RewriteRule ^$ index.php [QSA,L]
RewriteRule ^admin/?$ admin/admin_requests.php [QSA,L]
RewriteRule ^servicios/?$ servicios.php [QSA,L]
RewriteRule ^store/?$ store.php [QSA,L]
RewriteRule ^contacto/?$ contacto.php [QSA,L]
RewriteRule ^terminos-y-condiciones/?$ terminos-y-condiciones.php [QSA,L]
RewriteRule ^politica-de-privacidad/?$ politica-de-privacidad.php [QSA,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ROUTER GENÉRICO
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]